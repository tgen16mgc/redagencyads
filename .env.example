# Required for encrypted HttpOnly token session.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Workspace identity, credentials, sessions, recovery, and access requests use Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after the Google provider is configured in Supabase Auth.
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=false

# Optional access-request email notification. The request is always stored in Supabase.
# Resend's free tier is the recommended low-maintenance delivery path.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Decision Workspace <access@your-domain.com>
ACCESS_REQUEST_NOTIFICATION_EMAIL=

# Optional; default is v22.0 because it remains stable for Vercel runtime use.
META_GRAPH_VERSION=v22.0

# Optional Facebook Login. Required if using Login with Facebook instead of pasted tokens.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID. Its permissions must match lib/meta-oauth.ts.
META_LOGIN_CONFIG_ID=
# Must exactly match the valid OAuth redirect URI configured in the Meta app.
META_OAUTH_REDIRECT_URI=
# Optional long-lived system-user token for scheduled Meta budget-action resume jobs.
META_SYSTEM_ACCESS_TOKEN=

# Preferred AI gateway for Smart Assistant streaming and reasoning.
OPENROUTER_URL=https://openrouter.ai/api
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_MS=90000
OPENROUTER_MAX_TOKENS=2400
OPENROUTER_APP_NAME=Decision Workspace

# Legacy 9router fallback. If no AI key exists, local rule-based Verdicts/Insights still work.
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
NINEROUTER_MODEL=mhyc
NINEROUTER_TIMEOUT_MS=45000
NINEROUTER_MAX_TOKENS=1800

# Required for Competitor Evidence collection.
# Public Meta Ad Library links are navigation aids and are not treated as verified evidence.
APIFY_TOKEN=
APIFY_META_ADS_ACTOR_ID=
# Optional JSON template for actor-specific input. Supported placeholders:
# "{{competitors}}", "{{libraryUrls}}", "{{startUrls}}", "{{country}}", "{{limit}}",
# "{{competitors_csv}}", "{{library_urls_csv}}"
APIFY_META_ADS_INPUT_TEMPLATE=

# Optional TikTok Apify actors.
APIFY_TIKTOK_PROFILE_ACTOR_ID=clockworks/tiktok-profile-scraper
APIFY_TIKTOK_ADS_ACTOR_ID=brilliant_gum/tiktok-ads-library-scraper
APIFY_TIKTOK_PROFILE_INPUT_TEMPLATE=
APIFY_TIKTOK_ADS_INPUT_TEMPLATE=
# Optional official/approved Commercial Content Library or partner feed. When both are set, it takes precedence over the Apify actor.
TIKTOK_CCL_API_URL=
TIKTOK_CCL_ACCESS_TOKEN=

# Optional Google Ads / YouTube connector readiness for OAuth and scheduled sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Defaults to the current supported release documented on 2026-07-29.
GOOGLE_ADS_API_VERSION=v25
# Optional server-to-server token for CRON_SECRET-protected scheduled/internal sync only. Interactive routes require the encrypted browser OAuth cookie.
GOOGLE_ADS_ACCESS_TOKEN=
YOUTUBE_ACCESS_TOKEN=
# Preferred for durable scheduled Google Ads, YouTube, and Google budget-resume jobs. The server refreshes and briefly caches access tokens.
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Optional GA4 data-driven attribution. Interactive reads require shared Google browser OAuth; this token is reserved for trusted scheduled/internal jobs.
GA4_PROPERTY_ID=
GA4_ACCESS_TOKEN=

# Optional LinkedIn Marketing Developer Platform connector readiness.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_AD_ACCOUNT_ID=
# Optional server-to-server token for CRON_SECRET-protected scheduled/internal sync only.
LINKEDIN_ACCESS_TOKEN=
# Preferred for durable scheduled LinkedIn sync. Requires the LinkedIn OAuth client credentials above.
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_API_VERSION=202607

# Provider-fetched Meta and connector media hashing for cross-platform creative deduplication.
CONNECTOR_MEDIA_HASH_MAX_ASSETS=250
CONNECTOR_MEDIA_HASH_MAX_BYTES=10485760
CONNECTOR_MEDIA_HASH_TIMEOUT_MS=15000
# Interactive TikTok search uses a smaller default cap to preserve response latency.
TIKTOK_MEDIA_HASH_MAX_ASSETS=20
TIKTOK_MEDIA_HASH_MAX_BYTES=10485760
TIKTOK_MEDIA_HASH_TIMEOUT_MS=8000

# Scheduled jobs and outbound digests.
# Required for scheduled routes in production; local/test runs may omit it.
CRON_SECRET=
# Machine-readable production readiness and evidence certification.
DECISION_WORKSPACE_ENVIRONMENT=local
# Examples: vercel, airflow. Required before scheduler-backed gates can pass.
DECISION_WORKSPACE_SCHEDULER=
# The repository currently supports persistent_volume directly. Database or object-storage modes require a separate adapter before readiness will accept them.
DECISION_WORKSPACE_PERSISTENCE_MODE=
# Absolute mounted directory used by every default Decision Workspace store.
DECISION_WORKSPACE_DATA_DIR=
DECISION_WORKSPACE_ACCEPTANCE_TOKEN=
DECISION_WORKSPACE_ACCEPTANCE_ENVIRONMENT=local
DECISION_WORKSPACE_ACCEPTANCE_PATH=
BUDGET_ALERT_TOTAL_BUDGET=
BUDGET_ALERT_ACCOUNT=owned account
BUDGET_ALERT_CURRENCY=USD
BUDGET_ALERT_CURVE=linear
BUDGET_ALERT_SLACK_WEBHOOK=
BUDGET_ALERT_EMAIL_WEBHOOK=
TIKTOK_DIGEST_REGION=VN
# Used to report the real local delivery hour; align the UTC cron schedule with this timezone.
TIKTOK_DIGEST_TIMEZONE=Asia/Ho_Chi_Minh
TIKTOK_DIGEST_SLACK_WEBHOOK=
TIKTOK_DIGEST_EMAIL_WEBHOOK=
SLACK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Optional local paths / binaries for the DAM-lite and watchlist stores.
CREATIVE_ASSET_STORAGE_DIR=
TIKTOK_WATCHLIST_PATH=
TIKTOK_ACCEPTANCE_PATH=
# Dedicated certification boundary for production acceptance cohorts.
TIKTOK_ACCEPTANCE_TOKEN=
TIKTOK_ACCEPTANCE_ENVIRONMENT=development
ACTION_AUDIT_PATH=
PIPELINE_STORE_PATH=
INCREMENTALITY_PATH=
BUDGET_MODEL_PATH=
PROMPT_LIBRARY_PATH=
EXPERIMENT_LOG_PATH=
EXPERIMENT_ASSIGNMENT_PATH=
FFMPEG_PATH=ffmpeg

# Optional multimodal inference service. It accepts POST JSON operations:
# embeddings, elements, and audio. Without it, the UI labels deterministic fallbacks truthfully.
CREATIVE_INFERENCE_URL=
CREATIVE_INFERENCE_API_KEY=
CREATIVE_EMBEDDING_MODEL=clip
# Raw media larger than this limit is omitted from embedding requests and uses text metadata instead.
CREATIVE_INFERENCE_MAX_BYTES=10485760

# Backlog connector readiness markers.
X_ADS_CLIENT_ID=
PINTEREST_APP_ID=
SNAPCHAT_CLIENT_ID=
REDDIT_CLIENT_ID=
DV360_CLIENT_ID=
TTD_CLIENT_ID=
